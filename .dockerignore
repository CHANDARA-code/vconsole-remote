# The image builds two things: the client SDK bundle (from packages/) and the
# Go binary that embeds it (from server/). Everything below is build-irrelevant.
.git
.github
.agents
docs
test

# Dependencies and build outputs are produced inside the image, never copied in.
**/node_modules
packages/vconsole-remote/dist
packages/vconsole-remote/test
server/vconsole-remote
# Staged by scripts/build-sdk.sh for local runs; the sdk-builder stage
# regenerates it, so a stale local copy must not enter the context.
server/assets/sdk.js

Dockerfile
.dockerignore
docker-compose.yml
.env
.env.local
README.md
CONTRIBUTING.md
CHANGELOG.md
SECURITY.md
CODE_OF_CONDUCT.md
