{
  "name": "vconsole-remote",
  "version": "1.0.1",
  "description": "Lightweight remote debugging tool built on top of vConsole",
  "main": "dist/vconsole-remote.js",
  "module": "dist/vconsole-remote.esm.js",
  "unpkg": "dist/vconsole-remote.js",
  "browser": "dist/vconsole-remote.js",
  "exports": {
    ".": {
      "import": "./dist/vconsole-remote.esm.js",
      "require": "./dist/vconsole-remote.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "node test/vconsole-remote.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vconsole",
    "debugging",
    "remote",
    "mobile",
    "web",
    "devtools"
  ],
  "author": "chandara-code (https://github.com/CHANDARA-code)",
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4",
    "vconsole": "^3.15.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.24.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHANDARA-code/vconsole-remote.git",
    "directory": "packages/vconsole-remote"
  },
  "bugs": {
    "url": "https://github.com/CHANDARA-code/vconsole-remote/issues"
  },
  "homepage": "https://github.com/CHANDARA-code/vconsole-remote#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
