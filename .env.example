# vConsole Remote — server configuration
# Every value below is optional; the defaults are the ones shown here.
# Copy to .env and adjust for your deployment.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
PORT=8080

# Trust edge-proxy headers (CF-Connecting-IP, X-Forwarded-For, X-Real-IP) when
# resolving the client address. Turn this ON only when the server is genuinely
# behind a proxy you control, such as Cloudflare. With it on and no proxy in
# front, anyone can forge a header and walk straight through the rate limiter.
TRUST_PROXY=false

# Comma-separated origins allowed to open a dashboard (developer) connection.
# Empty means "allow any origin", which is convenient locally and wrong in
# production. Mobile SDK (device) connections are never origin-checked, because
# apps connect from arbitrary schemes.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Pairing & authorization
# ---------------------------------------------------------------------------
# Require the device owner to tap Allow before any data reaches a developer.
# This is the control that makes a 6-digit PIN safe to expose publicly.
# Never set this to false on a public server.
REQUIRE_DEVICE_APPROVAL=true

# Require the room key (the ?key= value carried by the QR code) in addition to
# the PIN. Turning this on means a PIN alone cannot even reach the prompt.
REQUIRE_ROOM_KEY=false

# How long a pending approval prompt stays actionable before it expires.
AUTH_APPROVAL_TIMEOUT=60s

# ---------------------------------------------------------------------------
# Brute-force protection
# ---------------------------------------------------------------------------
# Failed pairing attempts allowed per IP inside the window before a cooldown.
PIN_ATTEMPT_LIMIT=5
PIN_ATTEMPT_WINDOW=1m
PIN_BLOCK_DURATION=10m

# ---------------------------------------------------------------------------
# Session lifecycle (nothing is ever written to disk or a database)
# ---------------------------------------------------------------------------
# Hard cap on a room's lifetime, counted from device connection.
ROOM_MAX_DURATION=8h

# Rooms with no traffic for this long are destroyed early.
ROOM_IDLE_TIMEOUT=30m

# How often the reaper sweeps for expired rooms.
REAPER_INTERVAL=1m

# Upper bound on concurrent rooms held in memory.
MAX_ROOMS=10000
